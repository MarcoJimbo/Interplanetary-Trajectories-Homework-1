We can see that when $\alpha^+=0$,  $\mathbf{V}^+$ is maximum. While if $\alpha^+=\frac{\pi}{2}$,  $\mathbf{V}^+$ is minimum.\\
We can find it through:
\begin{equation*}
    \alpha^+=\alpha^--\delta \qquad cos(\alpha^-)=\frac{\mathbf{V_p}\cdot\mathbf{v_\infty}}{V_p\,v_\infty}
\end{equation*}
Eventually we can write the module of the final velocity w.r.t. $\alpha^+$:
\begin{equation*}
    V^+(\alpha^+)=\sqrt{V_p^2+v_\infty^2+2v_\infty V_p \cos{(\alpha^+)}}
\end{equation*}
\paragraph{Implementation Steps}
We do a maneuver called powered flyby, by eventually imposing a $\Delta V$ impulse in the pericenter of the hyperbole, that will be parallel to the instantaneous velocity.
\begin{enumerate}
    \item We set our free parameters $r_p$ and $\Delta V$.
    \item We compute the hyperbola characteristics before the impulse:
    \begin{eqnarray*}
       \mathbf{v_{\infty-}}=\mathbf{v_i}(r_{SoI})-\mathbf{v_{Planet}}\rightarrow v_{\infty-}=\|  \mathbf{v_{\infty-}}\|\rightarrow \varepsilon_{-} = \frac{v_{\infty}^2}{2} \quad ;\quad
        v_{p-} = \sqrt{v_{\infty}^2 + \frac{2\mu_{Body}}{r_p}} \quad\\
        a_{-} = -\frac{\mu_B} {2\varepsilon_{-}}\quad; \quad e_{-} = 1 + \frac{r_p v_{\infty}^2}{\mu_B} \quad \rightarrow \theta_{\infty, -} = \arccos\left(-\frac{1}{e_{-}}\right)
    \end{eqnarray*}
    \item We carry out the impulse. As the velocity at the pericenter is only tangential we only sum the imposed $\Delta V$:
    \begin{equation*}
        v_{p+} = v_{p-} + \Delta V 
    \end{equation*}
    \item We compute the characteristics of the new hyperbola:
    \begin{eqnarray*}
        \varepsilon_{+} = \frac{v_{p+}^2}{2} - \frac{\mu_B}{r_p} \quad ;\quad  v_{\infty+} = \sqrt{2 \varepsilon_{+}}\\
        a_{+} = -\frac{\mu_B}{2\varepsilon_{+}}\quad; \quad e_{+} = 1 + \frac{r_p v_{\infty+}^2}{\mu_B}
    \end{eqnarray*}
    And finally the true anomaly;
    \begin{equation*}
        \theta_{\infty, +} = \arccos\left(-\frac{1}{e_{+}}\right)
    \end{equation*}
    \item As we did for the computation of the time of flight in section \textbf{3.2.4} we use Kepler's equation with the parameters before the impulse and after the impulse.
    \item We  can compute the deflection angle in two ways:
    \begin{itemize}
        \item $ \delta_{tot} = \arcsin\left(\frac{1}{e_{-}}\right) + \arcsin\left(\frac{1}{e_{+}}\right)$
        \item $\delta_{tot} = (\pi - \theta_{\infty, -}) + (\pi - \theta_{\infty, +})$
    \end{itemize}
    \item We find the velocity vector in the inertial frame by rotating $\mathbf{v_{\infty-}}$ and summing it to $\mathbf{v_{Planet}}$:
    \begin{equation*}
        \mathbf{v_{\infty+}}=\begin{bmatrix}
            \cos(\delta)& \sin(\delta)& 0\\
            -\sin(\delta) &\cos(\delta) &0\\
            0&0&1
        \end{bmatrix}\mathbf{v_{\infty-}} \quad \rightarrow \quad \mathbf{v_f}=\mathbf{v_{\infty+}}+\mathbf{v_{Planet}}(t_0+\Delta t)
    \end{equation*}
    \end{enumerate}
    \subsubsection{Mathematical Model 4: Uranus Capture}
    To compute the $\Delta V$ needed for capture we first fix the $r_p$ and the $e$, then we compute the velocity at the pericenter.
    \begin{equation*}
        \Delta V_{Closure}=v_{p,Closure}-v_p
    \end{equation*}
