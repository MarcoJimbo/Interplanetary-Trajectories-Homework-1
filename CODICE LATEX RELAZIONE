\subsubsection{Mathematical Model 1: From The initial $\Delta V$ to parameters outside Earth's SoI}
We impose the first variable $h_{LEO}=1000\,km$ so we will have $r_{0,Earth}=R_{Earth}+h_{LEO}$.\\

We find the circular velocity and the pericenter velocity of the new orbit:
\[
v_{circ} = \sqrt{\frac{\mu_E}{r_{0,Earth}}}, \quad v_p = v_c + \Delta v
\]

We compute the hyperbolic excess velocity $v_{\infty}$ knowing $v_{esc}=\sqrt{\frac{2\mu_E}{r_{0,Earth}}}$ :

\[
v_{\infty} = \sqrt{v_p^2 - v_{esc}^2} = \sqrt{v_p^2 - \frac{2\mu_E}{r_p}}
\]
\[
a = \frac{\mu_E}{v_{\infty}^2}, \quad e = 1 + \frac{r_p v_{\infty}^2}{\mu_E}
\]
We compute the flight time to reach the SoI using Hyperbolic Anomaly $H$, where $H_{SoI}$ is the anomaly at $r_{SoI}$.\\
We use the relation between radius and Hyperbolic Anomaly to find $H_{SoI}$:
\[
r_{SOI} = a(e \cosh H_{SOI} - 1) \implies H_{SOI} = \cosh^{-1}\left( \frac{r_{SOI}/a + 1}{e} \right)
\]
To find $\Delta t$ we use Kepler's Equation for Hyperbolas:
\[
n_H = \sqrt{\mu_E/a^3} \qquad
\Delta t = \frac{e \sinh H_{SOI} - H_{SOI}}{n_H}
\]
This last equation is simplified because our trajectory starts at the pericenter, so $H_0=0$.
\subsubsection{Mathematical Model 2: Interplanetary Transfer Using Keplerian Dynamics}
This type of transfer is used between the maneuvers on the planets:
\begin{itemize}
    \item Earth $\longrightarrow$ Mars
    \item Mars $\longrightarrow$ Jupiter
    \item Jupiter $\longrightarrow$ Uranus
\end{itemize}
We will follow a general realization of the steps without treating any specific one.
\begin{enumerate}
    \item Starting with position $\mathbf{r}_i$ and velocity $\mathbf{v}_i$ in the Solar System Inertial Frame we compute the orbital parameters.
    \begin{eqnarray*}
        r = \|\mathbf{r}_i\|\quad; \quad v = \|\mathbf{v}_i\| \\
        \mathbf{h} = \mathbf{r}_i \times \mathbf{v}_i \quad\rightarrow \quad h = \|\mathbf{h}\|\\
        \mathbf{e} = \frac{\mathbf{v}_i \times \mathbf{h}}{\mu} - \frac{\mathbf{r}_i}{r} \quad\rightarrow\quad e=\|\mathbf{e}\|\\
        p = \frac{h^2}{\mu}\quad; \quad \varepsilon = \frac{v^2}{2} - \frac{\mu}{r}\\
        a = -\frac{\mu}{2\varepsilon}
    \end{eqnarray*}
    \item We asses the type of conic checking e:
    \begin{itemize}
    \item Circular: $e \approx 0$
    \item Elliptic: $0 < e < 1$
    \item Parabolic: $e \approx 1$
    \item Hyperbolic: $e > 1$
\end{itemize}
We will mostly have an elliptic orbit, unless we surpass the solar system's escape velocity. Which is likely only after Jupiter's gravity assist.
\item We check whether the final radius $r_f$ is reachable, by analyzing the final true anomaly.
\begin{equation*}
    r(\theta_f) = \frac{p}{1 + e \cos (\theta_f)} \qquad \cos (\theta_f) = \frac{1}{e} \left( \frac{p}{r_f} - 1 \right) 
\end{equation*}
\begin{itemize}
    \item If we are in an elliptic orbit we have to check that $\cos (\theta_f)<1$, otherwise we cannot reach it.
    \item If we are in an Hyperbolic orbit we have to check that $\theta_f<\theta_{max}\rightarrow\cos (\theta_{max})=-\frac{1}{e}$
\end{itemize}
\item We compute the $\Delta\theta$. We already know $\theta_f$. To compute $\theta_i$ using:
\begin{equation*}
    \theta_i = \operatorname{atan2}\left[ (\mathbf{e} \times \mathbf{r}_i) \cdot \mathbf{h}\quad, \quad \mathbf{e} \cdot \mathbf{r}_i \cdot h \,\right] \quad \rightarrow \quad \Delta \theta = (\theta_f - \theta_i) 
\end{equation*}
\item We compute the flight time:
\begin{itemize}
    \item \textbf{Elliptic Orbit:}
    We use Eccentric Anomaly turned into Mean Anomaly to use the Keplerian Equation.
    \begin{eqnarray*}
        \tan \left( \frac{E}{2}\right)  = \sqrt{\frac{1-e}{1+e}} \cdot \tan \left(\frac{\theta}{2}\right) \quad \rightarrow \quad
        M = E - e \sin (E)\\ \\ \Delta t = \frac{M_2 - M_1}{n} \qquad n = \sqrt{\frac{\mu}{a^3}} \hspace{4cm}
    \end{eqnarray*}
    \item \textbf{Hyperbolic Orbit:}We use Hyperbolic Anomaly turned into Mean anomaly to use the Keplerian Equation.
    \begin{eqnarray*}
        \tanh \left(\frac{H}{2}\right) = \sqrt{\frac{e-1}{e+1}} \tan \left(\frac{\theta}{2}\right) \quad \rightarrow \quad  M = e \sinh (H) - H \\ \\
        \Delta t = \frac{M_2 - M_1}{n_h}\qquad  n_h = \sqrt{\frac{\mu}{(-a)^3}} \hspace{4cm}
    \end{eqnarray*}
\end{itemize}
\item We reconstruct the vectors in the final time in the inertial reference frame using the peri-focal one. First we construct the rotation matrix:
\begin{equation*}
    \uu{\mathbf{R}}_{Perifocal}^{Inertial}=\left[\hat{\mathbf{P}} \; \hat{\mathbf{Q}} \; \hat{\mathbf{W}}\right] \quad \leftarrow \quad
    \hat{\mathbf{P}} = \frac{\mathbf{e}}{e}, \quad \hat{\mathbf{W}} = \frac{\mathbf{h}}{h}, \quad \hat{\mathbf{Q}} = \hat{\mathbf{W}} \times \hat{\mathbf{P}} 
\end{equation*}
The position and velocity vectors in the perifocal frame are:
\begin{equation*}
    \mathbf{r}_{Perifocal} = \begin{bmatrix} r_f \cos (\theta_f) \\ r_f \sin (\theta_f) \\ 0 \end{bmatrix}
    \qquad
    \mathbf{v}_{Perifocal} =\sqrt{\frac{\mu}{p}}\cdot \begin{bmatrix} -\sin (\theta_f) \\ e+\cos (\theta_f) \\ 0 \end{bmatrix}
\end{equation*}
The vectors in the inertial frame are:
\begin{equation*}
    \mathbf{r}_f = \uu{\mathbf{R}}_{Perifocal}^{Inertial} \cdot \mathbf{r}_{Perifocal} \qquad \mathbf{v}_f = \uu{\mathbf{R}}_{Perifocal}^{Inertial} \cdot \mathbf{v}_{Perifocal}
\end{equation*}
\end{enumerate}
\subsubsection{Mathematical Model 3: Flyby and Gravity Assist}
As we are using flybys to speed up the spacecraft we'll pass behind the planet, so the flybys are called "trailing side".
\paragraph{Pump Angle:}
By analyzing the velocity triangles of a flyby we can define $\alpha^+$ as the \textbf{pump angle}.
