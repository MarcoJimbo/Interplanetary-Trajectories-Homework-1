\section{Low Thrust Trajectory Model}
\subsection{Optimal Control Problem}


The problem consists in finding the optimal control vector $\mathbf{u}^*(t)$ such that, inserted into the system dynamics $\mathbf{f}(\mathbf{X}, \mathbf{u}^*, t)$, it produces the wanted state trajectory $\mathbf{X}^*(t)$ which minimizes the cost function $J$ generally subject to constraints. In the problem we define
\begin{itemize}
    \item \textbf{State Vector:} $\mathbf{X} = \begin{pmatrix} x_1 \\ \vdots \\ x_m \end{pmatrix}$.
    \item \textbf{Control Vector:} $\mathbf{u} = \begin{pmatrix} u_1 \\ \vdots \\ u_r \end{pmatrix}$. Can represent direction, intensity, or both.
    \item \textbf{Equations of Motion (EOM):}
    \begin{equation*}
        \dot{\mathbf{x}} = \mathbf{f}(\mathbf{x}, \mathbf{u}, t)
    \end{equation*}
    \item \textbf{Boundary Constraints:} Constraints on initial and final states:
    \begin{equation*}
        \mathbf{w}(\mathbf{x}_0, t_0, \mathbf{x}_f, t_f) = 0
    \end{equation*}
\end{itemize}

\subsection{Problem Classifications}
We can express the performance index $J$ in different ways.
\begin{itemize}
\item Mayer Problem :\\
The cost depends only on the boundary values (initial and final states):
\begin{equation*}
    J = J(\mathbf{x}_0, t_0, \mathbf{x}_f, t_f)
\end{equation*}
\item  Lagrange Problem:\\
The cost is purely an integral over the time interval:
\begin{equation*}
    J = \int_{t_0}^{t_f} L(\mathbf{x}, \mathbf{u}, t) \, dt
\end{equation*}
\item Bolza Problem:\\
A combination of both Mayer and Lagrange forms:
\begin{equation*}
    J = J(\mathbf{x}_0, t_0, \mathbf{x}_f, t_f) + \int_{t_0}^{t_f} L(\mathbf{x}, \mathbf{u}, t) \, dt
\end{equation*}
\end{itemize}
\subsubsection{Transforming Lagrange to Mayer}
We can always transform a Lagrange problem into a Mayer one by adding a state variable.
Let $x_{n+1}$ be an additional state such that:
\[
\begin{cases}
    \dot{x}_{n+1} = L(\mathbf{x}, \mathbf{u}, t) \\
    x_{n+1}(t_0) = 0
\end{cases}
\]
Then the final value is $x_{n+1}(t_f) = \int_{t_0}^{t_f} L \, dt = J$.

\subsection{Mayer Problem}
We need to find $\mathbf{x}_0, t_0, \mathbf{u}(t), t_f$ which render $J$ stationary and satisfy the constraints.
\[
\delta J = \left(\frac{\partial J}{\partial \mathbf{x}_0}\right)\delta \mathbf{x}_0 + \left(\frac{\partial J}{\partial t_0}\right)\delta t_0 + \left(\frac{\partial J}{\partial \vect{x}_f}\right)\delta \vect{x}_f + \left(\frac{\partial J}{\partial t_f}\right)\delta t_f = 0
\]
We have two types of constraints:
\begin{enumerate}
    \item \textbf{EOM (Differential constraint):} $\dot{\vect{x}} - \vect{f}(\vect{x}, \vect{u}, t) = 0$
    \item \textbf{Boundary constraints:} $\vect{\omega} = 0$
\end{enumerate}
We define an \textbf{augmented performance index K} using Lagrange multipliers.\\ For the dynamic constraint, the multiplier $\vect{p}(t)$ (also called the costate) that is a function of time. \\For the boundary constraints $\vect{w}$, we use constant multipliers $\vect{\lambda}$.

\begin{equation*}
    K = J + \sum_{s=1}^{p} \lambda_s w_s - \int_{t_0}^{t_f} \left( \vect{p}(t) \cdot (\dot{\vect{x}} - \vect{f}) \right) dt
\end{equation*}
We define the Hamiltonian $H = \vect{p} \cdot \vect{f}$:
\[
    K = J + \vect{\lambda} \cdot \vect{\omega} - \int_{t_0}^{t_f} (\vect{p} \cdot \dot{\vect{x}} - H) \, dt
\]
To optimize, we need $\delta K = 0$. Differentiating the terms, we derive the Euler-Lagrange equations and Transversality conditions.

\subsubsection{Euler-Lagrange Equations}
These equations define the costates and an important condition for the optimal control.
\begin{equation*}
\begin{cases}
    \dot{\vect{p}} = -\dfrac{\partial H}{\partial \vect{x}} & \text{(Adjoint Equation)} \\[1em]
    \dfrac{\partial H}{\partial \vect{u}} = 0 & \text{(Optimality Condition)}
\end{cases}
\end{equation*}

\subsubsection{Transversality Conditions}
\begin{align*}
    \text{Initial State:} \quad & \vect{p}_0 = - \frac{\partial J}{\partial \vect{x}_0} - \vect{\lambda} \frac{\partial \vect{w}}{\partial \vect{x}_0} \\
    \text{Initial Time:} \quad & H_0 = \frac{\partial J}{\partial t_0} + \vect{\lambda} \frac{\partial \vect{w}}{\partial t_0} \\
    \text{Final State:} \quad & \vect{p}_f = \frac{\partial J}{\partial \vect{x}_f} + \vect{\lambda} \frac{\partial \vect{w}}{\partial \vect{x}_f} \\
    \text{Final Time:} \quad & H_f = - \frac{\partial J}{\partial t_f} - \vect{\lambda} \frac{\partial \vect{w}}{\partial t_f}
\end{align*}
\subsection{Contensou-Pontryagin Problem}
It is a special Mayer problem where $\vect{X}_0\,,\,t_0$ and some components of $\vect{X}_f$ are fixed.(Eventually also $t_f$) For $\vect{X}\in\mathbb{R}^n$ the constraints are:
\[
\begin{cases}
    \vect{X}_0-\hat{\vect{X}}_0=0\\
    t_0-\hat{t}_0=0\\
    (t_f-\hat{t_f}=0)\\
    x_{f,i}-\hat{x}_{f,i}=0 \,\,\,\forall i<n
\end{cases}
\]
In this kind of problem we can apply the \textbf{Pontryagin Maximum Principle} that states: " Being $\vect{X}^*\,,\,\vect{u}^*\,,\,\vect{p}^*$ an optimal solution, if we fix $\vect{X}^*\,,\,\vect{p}^*$, $\forall t\quad \vect{u}(t)$ maximizes the Hamiltonian."
\begin{equation*}
    \vect{u}^*(t)=\arg \left( \max\{H(\vect{X}^*\,,\,\vect{u}\,,\,\vect{p}^*,t)\} \right)
\end{equation*}
We can also find \textbf{end points condition} using the transversality equations, an important one for when the final time is free is $H_f=0$.

\subsection{Model of CEV system for the optimization problem}
A Constant Ejection Velocity System is characterized by a linear behaviour in the $F-q$ Plane. The Ejection velocity is defined as $W=\frac{F}{q}$, where $F\,[N]$ is the thrust and $q\,[\frac{kg}{s}]$ is the mass rate. Other important quantities are:
\begin{itemize}
    \item Power: $P=\frac{1}{2}qW^2$
    \item Specific Impulse: $I_{SP}=\frac{W_{max}}{g_0}$
    \item Ration between maximum thrust and engine weight on ground: $\frac{F_{max}}{g_0 \cdot m_{Engine}}$
    \item Thrust Acceleration: $\Gamma=\frac{F}{m}\,[\frac{m}{s^2}]$.
\end{itemize}
This system can be both High Thrust and Low Thrust. The difference is in the range of the parameters:
\begin{itemize}
    \item High Thrust: $I_{SP}\in[300\,,\,1000]s$ while $\frac{F_{max}}{g_0 \cdot m_{Engine}}\in[10\,,\,100]$.
    \item Low Thrust:$I_{SP}\in[3000\,,\,10000]s$ while $\frac{F_{max}}{g_0 \cdot m_{Engine}}\in[10^{-4}\,,\,10^{-2}]$.
\end{itemize}
We can define a \textbf{performance index} as:
\begin{equation*}
    C=\int^t_{t_0}\Gamma\,dt
\end{equation*}
\subsection{2D Trajectory Optimization using the Pontryagin Problem}
As we want our problem to be a Mayer one, we add another state variable $\vect{X}=(x,y,v_x,v_y,C)^T$.\\
\textbf{State Equations:}
\begin{equation*}
    \begin{cases}
        \vect{{\dot{r}}}=\vect{v}\\
        \vect{\dot{v}}=\vect{g}(\vect{r},t)+\vect{\Gamma}\\
        \dot{C}=\Gamma
    \end{cases}
\end{equation*}
Where $\vect{\Gamma}=\Gamma\,\vect{D}$ is the Thrust acceleration vector($\vect{D}$ is the direction vector). We define another performance index:
\begin{equation*}
    J=-C_f
\end{equation*}
This time our goal is to maximize J (it would be the same of minimizing J=$C_f$).
\subsubsection{Definition of the Hamiltonian}
\begin{eqnarray*}
    H=\vect{p}\cdot\vect{f}=\vect{p_r}\cdot\vect{{\dot{r}}}+\vect{p_v}\cdot\vect{\dot{v}}+p_c\cdot\dot{C}=\\
    =\vect{p_r}\cdot\vect{v}+\vect{p_v}\cdot(\Gamma\,\vect{D+\vect{g}})+p_c\cdot\Gamma
\end{eqnarray*}
We use the Pontryagin Maximum Principle to find $\Gamma$ and $\vect{D}$:
\begin{itemize}
    \item To find $\vect{D}$, we must find the direction that maximizes $\vect{p_v}\cdot(\Gamma\,\vect{D+\vect{g}})$ and that happens when $\vect{D}\parallel \vect{p_v}$:\\
    \textbf{Optimal Direction:} \[\vect{D=\frac{\vect{p_v}}{\|\vect{p_v}\|}}\]
    \item To find $\Gamma$ we can write the module of the quantities in H as:
    \begin{eqnarray*}
        H=p_v\cdot\Gamma\,+p_c\cdot\Gamma +c
    \end{eqnarray*}
    Where c are the terms independent from the control. So we have to maximize $p_v\,\Gamma+p_c\,\Gamma$.\\
    In this case we can see that the optimal control is a bang-bang control where:
    \begin{equation*}
        \Gamma^*=
        \begin{cases}
    \Gamma_{max}\quad;\quad(\|\vect{p_v}\|+p_c)>0\\
    0\quad\,\,\,\,\quad;\quad(\|\vect{p_v}\|+p_c)\leq0\\        
        \end{cases}
    \end{equation*}
    We call $(\|\vect{p_v}\|+p_c)$ switch function. This function alternates Maximum Thrust Arcs to Coasting Arcs.
\end{itemize}
\subsubsection{Adjoint System}
We find the Adjoint System using the Euler Equation $\vect{\dot{p}}=-\frac{\partial H^*}{\partial \vect{X}}$.
\begin{equation*}
H^*=\vect{p_r}\cdot\vect{v}+\vect{p_v}\,\vect{{g}}+\Gamma_{max}\cdot \vect{D}^*\,\delta_{-1}(\|\vect{p_v}\|+p_c) \cdot (\|\vect{p_v}\|+p_c)
\end{equation*}
\begin{equation*}
    \vect{\dot{p}}=
    \begin{cases}
        \vect{\dot{p_r}}=-\vect{p_v\cdot\frac{\partial\vect{g}}{\partial\vect{r}}}\\
        \vect{\dot{p_v}}=-\vect{p_r}\\
        \dot{p_c}=-\frac{\Gamma_{max}}{W}(\|\vect{p_v}\|+p_c)\,\, \delta_{-1}(\|\vect{p_v}\|+p_c)
    \end{cases}
\end{equation*}
Where $\delta_{-1}(\cdot)$ is the step function and $\frac{\partial\vect{g}}{\partial\vect{r}}$ is the Dynamical Matrix. We see that when $(\|\vect{p_v}\|+p_c)\leq0\rightarrow\dot{p_c}=0$ so $p_c=const$.
\section{Low Thrust Trajectory Optimization}
\subsection{Dynamical Model}
We use the polar model as we did with the interplanetary trajectory. We have 10 scalar equations:
\begin{equation*}
\scalebox{1.3}{
    \begin{cases}
    \dot{r} = v_r \\
    \dot{\theta} = \frac{v_\theta}{r} \\
    \dot{v}_r = \frac{v_\theta^2}{r} - \frac{\mu}{r^2} + \Gamma_r \\
    \dot{v}_\theta = -\frac{v_r v_\theta}{r} + \Gamma_\theta\\
    \dot{C}=\Gamma^*\\
\end{cases}
\quad
\begin{cases}
    \dot{p}_r = p_\theta \frac{v_\theta}{r^2} + p_{v_r} \left( \frac{v_\theta^2}{r^2} + \frac{2\mu}{r^3} \right) - p_{v_\theta} \left( \frac{v_r v_\theta}{r^2} \right) \\
    \dot{p}_\theta = 0 \\
    \dot{p}_{v_r} = -p_r + p_{v_\theta} \frac{v_\theta}{r} \\
    \dot{p}_{v_\theta} = -\frac{p_\theta}{r} - 2 p_{v_r} \frac{v_\theta}{r} + p_{v_\theta} \frac{v_r}{r}\\
    \dot{p}_C = -\frac{\Gamma^*}{W} \left( ||\mathbf{p}_v|| + p_C \right)
\end{cases}
}
\end{equation*}
We define $\Gamma_r=\Gamma_{max}\cdot D_r$, while $\Gamma_{\theta}=\Gamma_{max}\cdot D_{\theta}$, and we find $\vect{D}$ through $\vect{p_v}$.\\
We can also write the extended form of the Hamiltonian:
\begin{equation*}
\scalebox{1.3}{
   $\displaystyle H = p_{r}\cdot v_{r} + p_{v_r}\cdot \left( \frac{v_{\theta}^2}{r} - \frac{\mu}{r^2} \right) - p_{v_\theta}\cdot \frac{v_{r}\cdot v_{\theta}}{r} + \Gamma^* \left( \|\vect{p_v}\|+p_c\right)$
    }
\end{equation*}
